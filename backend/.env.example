# Copy to .env and fill in after `azd up`. Nothing here has real values.

# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
# Name of the agent in the Foundry portal (Agents page)
FOUNDRY_AGENT_NAME=kacy
# Fallback if the above hits quota/region issues on a student subscription — see docs/architecture.md
FOUNDRY_MODEL_FALLBACK=Phi-4-mini-instruct

# Azure AI Search (RAG)
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_INDEX_NAME=kacy-handbook
SEARCH_API_KEY=

# Azure AI Content Safety (Prompt Shields)
CONTENT_SAFETY_ENDPOINT=https://<your-contentsafety>.cognitiveservices.azure.com
CONTENT_SAFETY_KEY=

# Azure AI Language (PII redaction)
LANGUAGE_ENDPOINT=https://<your-language>.cognitiveservices.azure.com
LANGUAGE_KEY=

# Semantic cache (optional — skip for solo-dev MVP)
REDIS_URL=

# Local dev
ENVIRONMENT=dev

# Demo only: log tool output before/after PII redaction. Never enable in production.
LOG_PII_DEMO=0

# Company timezone: working hours for meeting slots, and how times are shown
KACY_TZ=Asia/Kolkata

# Google sign-in + Gmail / Calendar / Drive.
# Enable these APIs in the same Google Cloud project: Gmail API, Google Calendar API, Google Drive API.
# Scopes requested at sign-in: gmail.send, gmail.readonly, calendar.events, calendar.freebusy, drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the "Authorized redirect URI" on the OAuth client exactly
GOOGLE_REDIRECT_URI=https://<your-codespace>-8000.app.github.dev/auth/google/callback
# Real accounts allowed to use Kacy and their role (intern|employee|manager|exec)
KACY_USER_ROLES=you@gmail.com=exec
